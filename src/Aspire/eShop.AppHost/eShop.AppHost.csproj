<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Services\Catalog\Catalog.API\Catalog.API.csproj" />
    <ProjectReference Include="..\..\Services\Stock.API\Stock.API.csproj" />
    <ProjectReference Include="..\..\Services\Payment.API\Payment.API.csproj" />
    <ProjectReference Include="..\..\ApiGateway\ApiGateway.csproj" />
  </ItemGroup>

  <!-- .env dosyası çıktı klasörüne kopyalanır; böylece AppHost hangi dizinden başlatılırsa başlatılsın bulunur. -->
  <ItemGroup>
    <None Include=".env" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.env')" />
  </ItemGroup>

</Project>
